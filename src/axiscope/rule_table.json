{
  "schema": "axiscope-rule-table/1",
  "source_of_truth": "docs/kb/KB3-tuning-rules.md",
  "scope": "C3 规则引擎最小可运行子集：只登记验收向量（KB4 算例 A/B、诚实真空例）真正走到的规则。后续规则按同一 schema 追加，不改结构。",
  "numbering_convention": {
    "rule": "`conditions[].n` 从 1 起，只在判据正文里编号的条款上递增；前置门禁（频带、`event_context.available ∧ causal_claims_permitted`）一律不占编号。",
    "why": "KB3 原文与 C3 契约的锚点（`R-03#2` = 相干、`R-19#6` = `corr_fe_vs_accel`）都按这个口径写；把门禁算进编号会让全部锚点错位。",
    "verified_against": [
      "R-03#2/#3/#4/#5/#6/#7",
      "R-19#2/#3/#4/#6"
    ]
  },
  "band_floor_source": "src/axiscope/features.py::BAND_FLOOR / BRANCH_FLOOR（KB3 §2.1 的唯一真值，本表不重复登记）",
  "evidence_policy": {
    "formula": "g(ρ)/g_cat/n_factor/band_factor 的算术在 src/axiscope/confidence.py（KB4 §2.1），本表只登记每条判据的输入。",
    "gate_conditions": "`evidence: false` 的条件是门，不计入 `A_sup`（KB4 §2.7 反自证条款：门禁条件计入支持证据会构成\"因为我能看所以我相信\"的自证）。带内成员条件同理——它声明的是可见性，不是强度。",
    "sample_scale": "`n_source` 是 KB4 §2.1(c) 的样本量配方，`n_ref` 是同一行的下限。两者为 null ⟹ 该判据不可复算，引擎必须报错并登记，不得默认 n_factor=1。"
  },
  "n_source_recipes": {
    "segment:<kind>": "segment_coverage.<kind>（C2 已登记）",
    "event:<field>": "event_context.<field>（C2 已登记）",
    "three_db_width_bins": "round(f0 / quality_factor_estimate / resonance.resolution_hz)（由 C2 已登记量导出）",
    "welch_segments": "Welch 段数 —— **C2 未提供该字段**，见 open_gaps welch_segments_not_in_c2",
    "band_bins": "峰邻域带宽内的 bin 数 —— **C2 未提供该字段**，见 open_gaps band_bins_not_in_c2"
  },
  "open_gaps": {
    "welch_segments_not_in_c2": "KB4 §2.3 算例 A 第 1 行取 n=8（\"Welch 8/4=2\"），但 C2 `resonance.estimation` 只有 window/nperseg/noverlap/method，段数需要记录长度才能反推。引擎要求调用方以 `sample_counts` 侧车显式带入，并写入 `audit.assumptions`。",
    "band_bins_not_in_c2": "算例 A 第 2 行取 n=96（\"带内 bin 96/15=6.4\"），而 `reliable_band_hz / resolution_hz = 3200/1.95 ≈ 1641`，两者对不上 ⟹ \"带内\"指的是峰邻域窗口，该窗口宽度在 C2 里没有承载字段。",
    "n_ref_disagrees_with_2_1_c": "算例 A 用 `n_ref = 15`（带内 bin）与 `n_ref = 8`（3 dB 宽），KB4 §2.1(c) 的下限表里带内 bin 写的是 ≥ 32，而 3 dB 宽根本没有对应行。本表按**算例自身**取值以复现 KB4/C3 的逐格数字，该冲突已由 **KB0 A-102** 落裁（算例为权威锚点，§2.1(c) 改逐判据行，C2 补 `resonance.estimation.n_segments` / `bins_in_band` / `candidates[].three_db_width_bins`），引擎不在两处之间偷偷取另一个值。"
  },
  "ops": [
    "gte",
    "lte",
    "gt",
    "lt",
    "eq",
    "neq",
    "between",
    "is_true",
    "is_false",
    "branch",
    "covers",
    "empty_or_quiet"
  ],
  "threshold_ref_form": "{\"ref\": \"<C2 路径>\", \"scale\": <系数，缺省 1>}",
  "scale_discipline": {
    "rule": "凡是 feature 路径里出现 `counts` 的条件必须显式标注 `\"counts_scale\": \"absolute\"|\"ratio\"`（A-97 ④）。**未标注者引擎按绝对处理**（保守侧）。键名不叫 `scale`：`threshold.scale` 已被规则 15 的倍率占用，同名两用会让读者把「阈值 ×3」读成「绝对/比值」。",
    "why": "`*_counts` 的后缀是历史名而非单位（A-97 ①）：绝对 counts 阈值在没有 counts 刻度的样本上不可套用（拿 m 当 counts 判是静默量纲替换），而比值/相关/相干类判据分子分母同单位、与刻度无关，必须照常评估。两种判据混在同一条规则里时，只有逐条标注才能区分「该阻塞」与「被连坐」。",
    "absolute_effect": "counts 刻度缺失（meta.units_are != 'counts' 且 counts_per_mm == null）时，该叶登记 not_evaluable + blocked_by = absent_counts_scale，reason 取固定句式「无 counts 刻度，绝对阈值不可比」。",
    "ratio_effect": "照算，不得被上一条连坐（KB3 §1.13b 同一条款）。"
  },
  "null_discipline": "null ≠ false（KB3 纪律 1）。必填条件取到 null 时按 `if_null` 处置，不得当成条件成立或不成立。",
  "rules": {
    "R-03": {
      "title": "kHz 级机械谐振检出（双惯性/结构模态）",
      "kind": "leaf",
      "family": "mechanical_resonance",
      "leaf": "mechanical_resonance",
      "severity": 3,
      "severity_provenance": "declared:KB4 §2.9 S3 + C3 示例 E1（单假设那份）",
      "src_line": 657,
      "gate": [
        {
          "expr": "freq_limits.reliable_band_hz >= band_floor('R-03')",
          "effect": "R-25",
          "_note": "不满足 ⟹ 本规则不得运行，进 blocked_rules，禁止输出\"未发现共振\"。不占条件编号。"
        }
      ],
      "conditions": [
        {
          "n": 1,
          "feature": "resonance.candidates[0].freq_hz",
          "op": "between",
          "threshold": [
            1000,
            6000
          ],
          "tier": "L",
          "required": true,
          "if_null": "unverified",
          "evidence": false,
          "_note": "带内成员条件（可见性），不进 A_sup。"
        },
        {
          "n": 2,
          "feature": "resonance.candidates[0].coherence_torque_velocity",
          "op": "gte",
          "threshold": 0.7,
          "tier": "P",
          "required": true,
          "if_null": "unverified",
          "evidence": true,
          "rule_id": "R-03a",
          "n_source": "welch_segments",
          "n_ref": 4
        },
        {
          "n": 3,
          "feature": "resonance.candidates[0].amplitude_ratio_vs_broadband",
          "op": "gte",
          "threshold": 4,
          "tier": "L",
          "required": true,
          "if_null": "unverified",
          "evidence": true,
          "n_source": "band_bins",
          "n_ref": 15
        },
        {
          "n": 4,
          "feature": "resonance.candidates[0].present_in_dwell",
          "op": "is_true",
          "tier": null,
          "required": true,
          "if_null": "unverified_cap_0.55",
          "evidence": true,
          "n_source": "segment:dwell",
          "n_ref": 1
        },
        {
          "n": 5,
          "feature": "resonance.candidates[0].present_in_rest",
          "op": "is_false",
          "tier": null,
          "required": true,
          "if_null": "unverified_cap_0.55",
          "evidence": true,
          "rule_id": "R-03b",
          "n_source": "segment:rest",
          "n_ref": 1
        },
        {
          "n": 6,
          "feature": "resonance.candidates[0].tracks_command_frequency",
          "op": "is_false",
          "tier": null,
          "required": true,
          "if_null": "unverified",
          "evidence": true,
          "n_source": "segment:move",
          "n_ref": 4
        },
        {
          "n": 7,
          "feature": "resonance.candidates[0].quality_factor_estimate",
          "op": "gte",
          "threshold": 10,
          "tier": "P",
          "required": true,
          "if_null": "unverified",
          "evidence": true,
          "n_source": "three_db_width_bins",
          "n_ref": 8,
          "guard": "resonance.resolution_hz <= 5"
