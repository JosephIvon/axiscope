      ],
      "refuters": [
        {
          "id": "R-03c",
          "feature": "step_response[0].damping_ratio_estimate",
          "op": "gt",
          "threshold": 0.15,
          "_note": "阻尼不低 ⟹ 峰不算尖锐，必须写进 contradicting_evidence（C3 规则 2）。"
        }
      ],
      "segment_prereqs": [
        "dwell >= 1",
        "rest >= 1"
      ],
      "falsified_by": [
        "R-10",
        "R-11"
      ]
    },
    "R-04": {
      "title": "谐振-反谐振配对判定（双惯性负载）",
      "kind": "leaf",
      "family": "mechanical_resonance",
      "leaf": "mechanical_resonance",
      "severity": 1,
      "severity_default": 3,
      "severity_when": "meta.drive.inertia_ratio > 10",
      "severity_provenance": "declared:KB4 §2.9 S1（inertia_ratio>10 ⟹ 参数对策无效、需机械整改）；默认级为同族推断，须记 assumption",
      "src_line": 715,
      "gate": [
        {
          "expr": "freq_limits.reliable_band_hz >= band_floor('R-04')",
          "effect": "R-25"
        }
      ],
      "conditions": [
        {
          "n": 1,
          "feature": "delta(resonance.candidates[0].freq_hz, resonance.candidates[0].antiresonance_freq_hz)",
          "op": "gte",
          "threshold": 0,
          "tier": "L",
          "required": true,
          "if_null": "unverified",
          "evidence": false,
          "skip_when": "meta.sensor_config in ['unknown', 'mixed']",
          "_note": "A-68：sensor_config ∈ {unknown, mixed} 时顺序项一律不参与判定且置信封顶；load_side 时镜像。顺序是门不是强度。"
        },
        {
          "n": 2,
          "feature": "ratio(resonance.candidates[0].freq_hz, resonance.candidates[0].antiresonance_freq_hz)",
          "op": "between",
          "threshold": [
            1.05,
            2.7
          ],
          "tier": "L",
          "required": true,
          "if_null": "unverified",
          "evidence": true,
          "n_source": null,
          "n_ref": null,
          "_note": "f_m/f_a = sqrt(1+λ)；λ=0.01 ⟹ 1.005 与单惯量不可区分 ⟹ 本规则必须不触发。"
        },
        {
          "n": 3,
          "feature": "delta(resonance.candidates[0].freq_hz, resonance.candidates[0].antiresonance_freq_hz)",
          "op": "gte",
          "threshold": {
            "ref": "resonance.resolution_hz",
            "scale": 2
          },
          "tier": "L",
          "required": true,
          "if_null": "unverified",
          "evidence": true,
          "n_source": null,
          "n_ref": null
        },
        {
          "n": 4,
          "feature": "resonance.candidates[0].is_double_inertia_pair",
          "op": "is_true",
          "tier": null,
          "required": true,
          "if_null": "unverified",
          "evidence": true,
          "n_source": null,
          "n_ref": null
        },
        {
          "n": 5,
          "feature": "resonance.candidates[0].peak_valley_power_ratio_db",
          "op": "gte",
          "threshold": 6,
          "tier": "L",
          "required": true,
          "if_null": "unverified",
          "evidence": true,
          "n_source": null,
          "n_ref": null
        },
        {
          "n": 6,
          "feature": "resonance.candidates[0].coherence_torque_velocity",
          "op": "gte",
          "threshold": 0.7,
          "tier": "P",
          "required": true,
          "if_null": "unverified",
          "evidence": true,
          "n_source": null,
          "n_ref": null
        },
        {
          "n": 7,
          "feature": "meta.drive.inertia_ratio",
          "op": "gte",
          "threshold": 5,
          "tier": "L",
          "required": false,
          "if_null": "unverified_branch_next_data",
          "evidence": true,
          "n_source": null,
          "n_ref": null
        }
      ],
      "veto": [
        {
          "expr": "meta.drive.notch_filters covers resonance.candidates[0].antiresonance_freq_hz",
          "effect": "reject",
          "_note": "谷是滤波造成的，不是反谐振。空数组 ≠ 未知，需区分。"
        },
        {
          "expr": "meta.sensor_config in ['unknown','mixed'] AND resonance.candidates[0].antiresonance_freq_hz > resonance.candidates[0].freq_hz",
          "effect": "reject_and_contradict",
          "_note": "纯两惯量不可能产生该顺序；转 R-10 与本条否决支，组合写入 contradicting_evidence。"
